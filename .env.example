# Public API base URL. Use /api for an IIS reverse-proxy, or a full API URL.
NUXT_PUBLIC_API_BASE=/api
# Backend origin used to generate IIS reverse-proxy rules after the server build.
NUXT_IIS_PROXY_TARGET=http://localhost:5258
# Loopback Nuxt Node origin used by the generated IIS catch-all rule.
NUXT_IIS_NODE_TARGET=http://127.0.0.1:3001
# Server-only API URL used by request-time SSR and discovery routes.
NUXT_API_SERVER_BASE=http://localhost:5258/api/v1/public
# Server-only formal site API URL used by request-time site-shell rendering.
NUXT_SITE_API_SERVER_BASE=http://localhost:5258/api/public
# Server-only credential shared with API TrustedSsr__ApiKey. Use a random value of at least 32 characters.
NUXT_TRUSTED_SSR_API_KEY=replace-with-the-same-random-trusted-ssr-key-as-the-api
# Total timeout for each content API read. Runtime normalization clamps this to 1-30 seconds.
NUXT_CONTENT_API_TIMEOUT_SECONDS=8
NUXT_PUBLIC_SITE_API_BASE=/api/public

# Production Node runtime. Bind Nitro to loopback because IIS is the public edge.
NODE_ENV=production
NITRO_HOST=127.0.0.1
NITRO_PORT=3001

# Public AMap Web JS API key. Keep securityJsCode on the API server only.
NUXT_PUBLIC_AMAP_KEY=

# Set this when deploying under an IIS virtual directory, for example /ulink/.
NUXT_APP_BASE_URL=/

NUXT_PUBLIC_SITE_URL=https://www.szulink.com.cn

# Forum posts are indexed only when their visible body has at least this many non-whitespace characters
# or they have at least this many public replies; others render `noindex, follow` and leave sitemap.xml.
NUXT_PUBLIC_FORUM_INDEX_MIN_BODY_CHARS=300
NUXT_PUBLIC_FORUM_INDEX_MIN_COMMENTS=3
